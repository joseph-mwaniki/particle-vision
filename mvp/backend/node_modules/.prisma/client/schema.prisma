datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Job {
  id         String   @id @default(cuid())
  status     String // PENDING, PROCESSING_COLMAP, PROCESSING_GSPLAT, COMPLETED, FAILED
  progress   Float    @default(0.0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  imagesPath String
  splatPath  String?
  logs       String?
}
