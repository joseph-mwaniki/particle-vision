datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Job {
  id            String    @id @default(cuid())
  status        String
  progress      Float     @default(0.0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  imagesPath    String
  splatPath     String?
  collisionPath String?
  logs          String?   @db.Text
  uploadSessionId String?  @unique
  uploadSession UploadSession? @relation(fields: [uploadSessionId], references: [id], onDelete: SetNull)
  Splats        Splat[]
}

model UploadSession {
  id               String       @id
  status           String       @default("UPLOADING")
  originalFileName String       @default("dataset.zip")
  totalSize        BigInt       @default(0)
  totalFiles       Int          @default(0)
  storagePrefix    String
  combinedKey      String?
  job              Job?
  files            UploadFile[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  expiresAt        DateTime

  @@index([status])
  @@index([expiresAt])
}

model UploadFile {
  id             String        @id
  sessionId      String
  session        UploadSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  originalName   String
  objectKey      String        @unique
  size           BigInt
  multipartId    String
  partSize       Int
  totalParts     Int
  completedParts Json          @default("[]")
  status         String        @default("UPLOADING")
  createdAt      DateTime      @default(now())
  completedAt    DateTime?

  @@index([sessionId])
}

model Splat {
  id            String    @id @default(uuid())
  title         String
  slug          String    @unique
  description   String?   @db.Text
  status        String    @default("draft")
  splatPath     String
  collisionPath String?
  thumbnailUrl  String?
  cameraConfig  Json?
  shareToken    String    @unique @default(uuid())
  views         Int       @default(0)
  isPublic      Boolean   @default(true)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  jobId         String?
  Job           Job?      @relation(fields: [jobId], references: [id], onDelete: SetNull)

  @@index([slug])
  @@index([status])
  @@index([shareToken])
}