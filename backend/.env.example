# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration (PostgreSQL with Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/particle_vision?schema=public"

# API Key for administrative / management access (leave empty or set secret key)
