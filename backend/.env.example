# Server configuration
PORT=3001
NODE_ENV=development

# PostgreSQL metadata store
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/particle_vision?schema=public

# API and worker URLs
API_KEY=replace-with-a-long-random-value
FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:3001
GPU_WORKER_URL=http://localhost:8080
USE_MOCK_WORKER=false

# S3-compatible storage (Cloudflare R2)
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY_ID=replace-with-r2-access-key-id
S3_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
S3_BUCKET=replace-with-r2-bucket-name
S3_PUBLIC_URL_PREFIX=
S3_FORCE_PATH_STYLE=false
S3_UPLOAD_PART_SIZE=67108864
S3_PRESIGN_EXPIRES_SECONDS=900
S3_DOWNLOAD_EXPIRES_SECONDS=43200

# Upload limits
MAX_UPLOAD_FILES=20
MAX_UPLOAD_FILE_SIZE=5368709120
MAX_UPLOAD_TOTAL_SIZE=21474836480
